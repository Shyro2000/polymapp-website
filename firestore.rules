rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnUser(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function isActiveCompanyMember(companyId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)
        ).data.status == "active";
    }

    function hasCompanyRole(companyId, allowedRoles) {
      return isActiveCompanyMember(companyId)
        && get(
          /databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)
        ).data.role in allowedRoles;
    }

    function changesProtectedCompanyUserFields() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
       .hasAny([
  "companyId",
  "companyJoinedAt",
  "companyMembershipUpdatedAt",
  "companyFeatureAccess",
  "accountDeletionStatus",
  "accountDeletionCompanyId",
  "accountDeletionStartedAt"
]);
    }

    function containsProtectedCompanyUserFields() {
      return request.resource.data.keys().hasAny([
  "companyId",
  "companyJoinedAt",
  "companyMembershipUpdatedAt",
  "companyFeatureAccess",
  "accountDeletionStatus",
  "accountDeletionCompanyId",
  "accountDeletionStartedAt"
]);
    }

    // Benutzerprofil
    match /users/{userId} {

      allow get:
        if isOwnUser(userId);

      allow create:
        if isOwnUser(userId)
        && !containsProtectedCompanyUserFields();

      allow update:
        if isOwnUser(userId)
        && !changesProtectedCompanyUserFields();

      // Account-Löschungen erfolgen nur über die Cloud Function.
allow delete:
  if false;

      // Referral-Abfragen dürfen nur eigene Empfehlungen liefern.
      allow list:
        if isSignedIn()
        && resource.data.referredBy == request.auth.uid;
    }

    // Trial-Geräte
    match /trial_devices/{deviceId} {

      function hasValidTrialFields() {
        return request.resource.data.keys().hasAll([
          "deviceId",
          "uid",
          "mode",
          "trialStartedAt",
          "trialEndsAt",
          "availableTrialDays",
          "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "deviceId",
          "uid",
          "mode",
          "trialStartedAt",
          "trialEndsAt",
          "availableTrialDays",
          "createdAt",
          "claimedAt"
        ])
        && request.resource.data.deviceId == deviceId
        && request.resource.data.deviceId is string
        && request.resource.data.mode is string
        && request.resource.data.trialStartedAt is timestamp
        && request.resource.data.trialEndsAt is timestamp
        && request.resource.data.availableTrialDays is int
        && request.resource.data.availableTrialDays > 0
        && request.resource.data.availableTrialDays <= 45
        && request.resource.data.trialEndsAt >
           request.resource.data.trialStartedAt
        && request.resource.data.createdAt == request.time;
      }

      allow get:
        if true;

      allow list:
        if false;

      allow create:
        if !exists(
          /databases/$(database)/documents/trial_devices/$(deviceId)
        )
        && hasValidTrialFields()
        && (
          (
            request.auth == null
            && request.resource.data.mode == "guest"
            && request.resource.data.uid == null
            && request.resource.data.availableTrialDays <= 30
          )
          ||
          (
            isSignedIn()
            && request.resource.data.mode == "registered"
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.availableTrialDays <= 45
          )
        );

      allow update:
        if isSignedIn()
        && resource.data.deviceId == deviceId
        && request.resource.data.deviceId == deviceId
        && (
          resource.data.uid == null
          || resource.data.uid == request.auth.uid
        )
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mode == "registered"
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "uid",
            "mode",
            "claimedAt"
          ]);

      allow delete:
        if false;
    }

    // Präferenzen
    match /users/{userId}/preferences/{preferenceName} {
      allow read, write:
        if isOwnUser(userId);
    }

    // G-/M-Code Änderungen
    match /users/{userId}/code_changes/{filename} {

      allow read, write:
        if isOwnUser(userId);

      match /changes/{changeId} {

        allow read, write:
          if isOwnUser(userId);
      }
    }

    // Private Maschinen und Werkzeuge
    match /users/{userId}/machines/{machineId} {

      allow read, write:
        if isOwnUser(userId);

      match /werkzeuge/{toolId} {

        allow read, write:
          if isOwnUser(userId);
      }
    }

    // Firmen
    match /companies/{companyId} {

      allow read:
        if isActiveCompanyMember(companyId);

      // Firmenstammdaten werden über Cloud Functions verändert.
      allow create, update, delete:
        if false;

      // Öffentliche Mitgliedschaft innerhalb der Firma
      match /members/{memberId} {

        allow read:
          if isActiveCompanyMember(companyId);

        // Rollen und Mitgliedschaften nur über Cloud Functions.
        allow create, update, delete:
          if false;
      }

      // Notizen und administrative Mitgliederdaten
      match /memberAdminData/{memberId} {

        allow read:
          if hasCompanyRole(
            companyId,
            ["owner", "admin"]
          );

        allow create, update, delete:
          if false;
      }

      // Firmenmaschinen
      match /machines/{machineId} {

        allow read:
          if isActiveCompanyMember(companyId);

        // Editor darf keine Maschinen erstellen oder verändern.
        allow create, update, delete:
          if hasCompanyRole(
            companyId,
            ["owner", "admin"]
          );

        // Werkzeuge einer Firmenmaschine
        match /werkzeuge/{toolId} {

          allow read:
            if isActiveCompanyMember(companyId);

          allow create, update, delete:
            if hasCompanyRole(
              companyId,
              ["owner", "admin", "editor"]
            );
        }
      }
    }

    // Firmeneinladungen
    match /companyInvitations/{invitationId} {

      allow read:
        if (
          isSignedIn()
          && request.auth.token.email is string
          && resource.data.invitedEmail is string
          && resource.data.invitedEmail ==
             request.auth.token.email
        )
        ||
        (
          resource.data.companyId is string
          && hasCompanyRole(
            resource.data.companyId,
            ["owner", "admin"]
          )
        );

      // Statusänderungen nur über Cloud Functions.
      allow create, update, delete:
        if false;
    }

    // Beta-Tester
    match /beta_testers/{email} {

      allow read:
        if isSignedIn();

      allow write:
        if false;
    }

    // Alles andere verbieten
    match /{document=**} {
      allow read, write:
        if false;
    }
  }
}
