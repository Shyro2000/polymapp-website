rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Benutzerprofil
    match /users/{userId} {

      allow get:
        if request.auth != null
        && request.auth.uid == userId;

      allow create:
        if request.auth != null
        && request.auth.uid == userId;

      allow update:
        if request.auth != null
        && request.auth.uid == userId;

      allow delete:
        if request.auth != null
        && request.auth.uid == userId;

      // Aktuell für die Referral-Statistik benötigt
      allow list:
        if request.auth != null;
    }

    // Trial-Geräte
    match /trial_devices/{deviceId} {

      function hasValidTrialFields() {
        return request.resource.data.keys().hasAll([
          "deviceId",
          "uid",
          "mode",
          "trialStartedAt",
          "trialEndsAt",
          "availableTrialDays",
          "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "deviceId",
          "uid",
          "mode",
          "trialStartedAt",
          "trialEndsAt",
          "availableTrialDays",
          "createdAt",
          "claimedAt"
        ])
        && request.resource.data.deviceId == deviceId
        && request.resource.data.deviceId is string
        && request.resource.data.mode is string
        && request.resource.data.trialStartedAt is timestamp
        && request.resource.data.trialEndsAt is timestamp
        && request.resource.data.availableTrialDays is int
        && request.resource.data.availableTrialDays > 0
        && request.resource.data.availableTrialDays <= 45
        && request.resource.data.trialEndsAt >
           request.resource.data.trialStartedAt
        && request.resource.data.createdAt == request.time;
      }

      allow get:
        if true;

      allow list:
        if false;

      allow create:
        if !exists(
          /databases/$(database)/documents/trial_devices/$(deviceId)
        )
        && hasValidTrialFields()
        && (
          (
            request.auth == null
            && request.resource.data.mode == "guest"
            && request.resource.data.uid == null
            && request.resource.data.availableTrialDays <= 30
          )
          ||
          (
            request.auth != null
            && request.resource.data.mode == "registered"
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.availableTrialDays <= 45
          )
        );

      allow update:
        if request.auth != null
        && resource.data.deviceId == deviceId
        && request.resource.data.deviceId == deviceId
        && (
          resource.data.uid == null
          || resource.data.uid == request.auth.uid
        )
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mode == "registered"
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "uid",
            "mode",
            "claimedAt"
          ]);

      allow delete:
        if false;
    }

    // Präferenzen
    match /users/{userId}/preferences/{preferenceName} {
      allow read, write:
        if request.auth != null
        && request.auth.uid == userId;
    }

    // G-/M-Code Änderungen
    match /users/{userId}/code_changes/{filename} {

      allow read, write:
        if request.auth != null
        && request.auth.uid == userId;

      match /changes/{changeId} {

        allow read, write:
          if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Maschinen
    match /users/{userId}/machines/{machineId} {

      allow read, write:
        if request.auth != null
        && request.auth.uid == userId;

      // Werkzeuge
      match /werkzeuge/{toolId} {

        allow read, write:
          if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Beta-Tester
    match /beta_testers/{email} {

      allow read:
        if request.auth != null;

      allow write:
        if false;
    }

    // Alles andere verbieten
    match /{document=**} {

      allow read, write:
        if false;
    }
  }
}